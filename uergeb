def main():
    parser = argparse.ArgumentParser(description="Sarvam AI Multilingual OSINT Fusion Workbench")
    parser.add_argument("--sample", action="store_true", default=True, help="Run with built-in multilingual case study")
    parser.add_argument("--output", type=str, default="fusion_graph_output.json", help="Output path for fused knowledge graph")
    parser.add_argument("--interactive", action="store_true", help="Launch interactive analyst verification console")
    args = parser.parse_args()

    print("[*] Initializing OSINT Fusion Workbench with Sarvam AI...")
    workbench = OSINTFusionWorkbench()

    inputs = get_sample_intelligence_corpus()
    fusion_result = workbench.run_fusion_pipeline(inputs)

    display_dashboard(fusion_result)

    # Save initial output
    with open(args.output, "w", encoding="utf-8") as f:
        json.dump(fusion_result, f, indent=2, ensure_ascii=False)
    print(f"\n[+] Intelligence knowledge graph exported to: {args.output}")

    if args.interactive:
        interactive_analyst_review(fusion_result, args.output)


if __name__ == "__main__":
    main()
